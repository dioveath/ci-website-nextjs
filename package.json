{
  "name": "ci-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "bash scripts/dev-emulators.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "verify": "npm run typecheck && npm run lint && npm run contrast",
    "admin": "tsx --conditions=react-server scripts/admin.ts",
    "admin:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-charicha tsx --conditions=react-server scripts/admin.ts",
    "test": "tsx --conditions=react-server --test 'tests/unit/**/*.test.ts'",
    "test:integration": "firebase emulators:exec --config emulators/firebase.test.json --project demo-charicha-test --only auth,firestore \"tsx --conditions=react-server --test --test-concurrency=1 'tests/integration/**/*.test.ts'\"",
    "test:rules": "firebase emulators:exec --config emulators/firebase.test.json --project demo-charicha-test --only firestore \"tsx --test 'tests/rules/**/*.test.ts'\""
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.0",
    "groq": "^6.23.0",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-player": "^3.4.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@portabletext/types": "^4.0.2",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "~1.13.7",
    "postcss-selector-parser": "^6.1.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "allowScripts": {
    "@firebase/util": false,
    "@tsparticles/engine": false,
    "esbuild": false,
    "protobufjs": false
  }
}
