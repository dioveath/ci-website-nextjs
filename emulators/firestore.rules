rules_version = '2';
// LOCAL EMULATOR ONLY -- wide open so the app can be exercised without a real
// project. These are not the production rules and must never be deployed:
// the dev script runs under a `demo-` project, which cannot be deployed to.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
