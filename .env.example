# ---------------------------------------------------------------------------
# Charicha Institute — environment template
#
#   cp .env.example .env.local     # then fill in the values below
#
# .env.local is gitignored. Never commit real values.
# ---------------------------------------------------------------------------


# === Firebase — REQUIRED ====================================================
#
# Firebase backs user accounts, user-written articles, and file storage.
# These are needed to BUILD, not just to run: the Firebase SDK rejects an
# empty API key (auth/invalid-api-key) while pages are prerendered.
#
# Where to get them:
#   Firebase Console -> your project -> Project settings (gear icon)
#   -> General -> Your apps -> Web app -> "SDK setup and configuration"
#   -> select "Config". Copy each field across.
#
# NOTE ON SECRECY: these are client-side config, not credentials. They are
# deliberately shipped to the browser (the NEXT_PUBLIC_ prefix makes Next
# inline them into the client bundle at build time), which is normal for
# Firebase web apps — access is enforced by Firestore Security Rules, not by
# hiding these. Still keep .env.local out of git.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# === Firebase Admin (server only) — REQUIRED for courses ==================
#
# Enrollment, lessons, payments and the admin tools run on the server with the
# Firebase Admin SDK. Without it, the catalog still renders but every course
# action answers "not available right now".
#
# Not needed for `npm run dev:emulators`, which uses the local emulators.
#
# Where to get it: Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key". Paste the whole JSON on ONE line. These are real
# credentials: never prefix them with NEXT_PUBLIC_, never commit them.
# On Firebase App Hosting / Cloud Run, leave them blank: Application Default
# Credentials are used automatically.

FIREBASE_SERVICE_ACCOUNT=
# ...or, instead of the JSON, the two fields it contains:
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=


# === Payments (server only) ===============================================
#
# eSewa and Khalti. Students are sent back to SITE_URL after paying, and every
# payment is confirmed server to server before access is granted (COURSES.md).
#
# PAYMENTS_ENV=sandbox (default) uses the providers' test systems: no real
# money. eSewa works out of the box in sandbox with its public test merchant
# (EPAYTEST); Khalti needs a sandbox key from https://test-admin.khalti.com.
# Set PAYMENTS_ENV=live only with live merchant keys.
#
# A provider without credentials is simply not offered at checkout.

PAYMENTS_ENV=sandbox
# Public origin, no trailing slash. Defaults to http://localhost:3000 in dev.
SITE_URL=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=


# === Sanity CMS — OPTIONAL ==================================================
#
# Leave these blank and the site still works: every CMS-backed page falls back
# to the bundled static content in lib/sanity/fallbacks.ts, and /blog simply
# shows Firebase articles only. See SANITY.md.
#
# Fill them in to turn the CMS on. PROJECT_ID comes from sanity.io/manage
# (or `npx sanity init` in studio/). Must match studio/.env.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Paid lesson bodies live in a PRIVATE dataset that only the server reads
# (SANITY.md, "Course content"). Create a token with Viewer access at
# sanity.io/manage -> API -> Tokens. Server only: never NEXT_PUBLIC_.
# Without it, lessons still open (video plays) minus their written content.
SANITY_READ_TOKEN=
SANITY_CONTENT_DATASET=course-content


# ---------------------------------------------------------------------------
# Removed — do not re-add
#
#   MONGODB_URI / DB_NAME
#     lib/mongodb.js had zero callers and threw at import time if these were
#     unset. Deleted along with the `mongodb` dependency.
#
#   AUTH0_* 
#     @auth0/nextjs-auth0 was installed with a live /api/auth/[...auth0]
#     route, but nothing in the app ever called it — real auth is Firebase.
#     Route and dependency both deleted.
# ---------------------------------------------------------------------------
